{
  "name": "@platforma-open/milaboratories.cluster-markers",
  "version": "1.4.1",
  "files": [
    "dist",
    "block-pack"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "sources": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,vue}\"",
    "build": "ts-builder build --target block-facade && block-tools pack",
    "mark-stable": "block-tools mark-stable -r 's3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1'",
    "prepublishOnly": "block-tools publish -r s3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1 --registry-serve-url https://blocks.pl-open.science",
    "check": "ts-builder type-check --target block-facade",
    "do-pack": "shx rm -f package.tgz && pnpm pack && shx mv *.tgz package.tgz"
  },
  "dependencies": {},
  "devDependencies": {
    "@milaboratories/ts-builder": "catalog:",
    "@milaboratories/ts-configs": "catalog:",
    "@platforma-open/milaboratories.cluster-markers.kind": "workspace:*",
    "@platforma-open/milaboratories.cluster-markers.model": "workspace:*",
    "@platforma-open/milaboratories.cluster-markers.ui": "workspace:*",
    "@platforma-open/milaboratories.cluster-markers.workflow": "workspace:*",
    "@platforma-sdk/block-tools": "catalog:",
    "@platforma-sdk/model": "catalog:",
    "shx": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.12.0",
  "block": {
    "components": {
      "workflow": "@platforma-open/milaboratories.cluster-markers.workflow/dist/tengo/tpl/main.plj.gz",
      "model": "@platforma-open/milaboratories.cluster-markers.model/dist/model.json",
      "ui": "@platforma-open/milaboratories.cluster-markers.ui/dist"
    },
    "meta": {
      "title": "Cluster Markers",
      "logo": "file:../logos/block-logo.png",
      "url": "https://github.com/platforma-open/cluster-markers",
      "docs": "https://docs.platforma.bio/guides/sc-rna-seq-analysis/clusters-markers/",
      "support": "mailto:support@milaboratories.com",
      "description": "Identifies marker genes distinguishing cell clusters using Wilcoxon rank-sum test.",
      "longDescription": "file:../docs/description.md",
      "changelog": "file:../CHANGELOG.md",
      "tags": [
        "RNA-seq",
        "downstream",
        "single-cell"
      ],
      "organization": {
        "name": "MiLaboratories Inc",
        "url": "https://milaboratories.com/",
        "logo": "file:../logos/organization-logo.png"
      },
      "marketplaceRanking": 12400
    }
  }
}
